{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "WebFetch",
      "WebSearch",
      "mcp__*"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": false
  },
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,
  "enableWorkflows": true,
  "enabledPlugins": {
    "typesafe@typesafe-ai": true
  }
}
