# mcp.env — machine-local values for the ${...} placeholders in servers.json.
#
#   cp ai/mcp/mcp.env.example ~/.config/dotfiles/mcp.env
#   chmod 600 ~/.config/dotfiles/mcp.env
#
# This file is NEVER tracked by git. It is where API tokens live: put
# ${GITHUB_TOKEN} in servers.json and the real value here.
#
# render.sh auto-detects UV_BIN and MCP_SRC_DIR when it can, so you usually
# only need to set the ones it can't guess. Anything you set here wins.

# --- Paths ------------------------------------------------------------------

# The `uv` binary that launches the Python MCP servers.
# Auto-detected via `command -v uv` if unset.
#   Linux/macOS: /home/you/.local/bin/uv
#   Windows:     C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\astral-sh.uv_...\uv.exe
#UV_BIN=

# Checkout of the mcp-local-readonly repo (provides obsidian-mcp, anki-mcp).
# Auto-detected at ~/Projects/MCP if unset.
#MCP_SRC_DIR=

# Obsidian vault the read-only server exposes. No default — set this.
OBSIDIAN_VAULT_PATH=$HOME/Documents/Study

# --- Windows / WSL ----------------------------------------------------------
#
# Prefer POSIX paths. render.sh converts them to C:\... for any client that a
# Windows application reads, so one value works for every target.
#
#   from Git Bash:  /c/Users/you/Vaults/Study
#   from WSL:       /mnt/c/Users/you/Vaults/Study
#
# The two are not interchangeable: MSYS mangles /mnt/c/... into
# C:/Program Files/Git/mnt/c/... when it reaches a native Windows program.
#
# A native Windows path must be single-quoted, or the shell eats the
# backslashes when this file is sourced:
#   OBSIDIAN_VAULT_PATH='C:\Users\you\Vaults\Study'

# --- Secrets (examples) -----------------------------------------------------
#
#GITHUB_TOKEN=
#LINEAR_API_KEY=
